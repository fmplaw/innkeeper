{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "InnkeeperSync",
	"version": "../package.json",
	"identifier": "io.github.fmplaw.innkeeper-sync",
	"build": {
		"frontendDist": "../dist",
		"beforeBuildCommand": "node build.mjs"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "InnkeeperSync",
				"width": 460,
				"height": 640,
				"minWidth": 380,
				"minHeight": 480,
				"visible": false,
				"backgroundColor": "#141110"
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis", "appimage"],
		"createUpdaterArtifacts": true,
		"publisher": "Innkeeper",
		"copyright": "Innkeeper, licence AGPL-3.0",
		"license": "AGPL-3.0-only",
		"category": "Game",
		"shortDescription": "Synchronise l'addon InnkeeperSync avec le site de ta guilde",
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
		"windows": {
			"nsis": {
				"installMode": "currentUser",
				"installerIcon": "icons/icon.ico",
				"languages": ["French"],
				"displayLanguageSelector": false
			}
		}
	},
	"plugins": {
		"deep-link": {
			"desktop": { "schemes": ["innkeeper"] }
		},
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGRDBCNDRDMkQyQUQ4NTYKUldSVzJDb3RUTFRRVHdVSHhBblZjV0ZaNjJOY3h6TnQrMWRFQUxITEFiby9EQXdsR2RkcUxnTFkK",
			"endpoints": ["https://github.com/fmplaw/innkeeper/releases/latest/download/latest.json"],
			"windows": { "installMode": "passive" }
		}
	}
}
