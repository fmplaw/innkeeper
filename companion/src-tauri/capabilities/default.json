{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Droits de la fenêtre : lecture seule des fichiers de l'addon, appels HTTPS au site de la guilde.",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"core:app:allow-default-window-icon",
		"core:tray:default",
		"core:menu:default",
		"core:window:allow-show",
		"core:window:allow-hide",
		"core:window:allow-unminimize",
		"core:window:allow-set-focus",
		"autostart:allow-enable",
		"autostart:allow-disable",
		"autostart:allow-is-enabled",
		"deep-link:default",
		"dialog:allow-open",
		"notification:default",
		"process:allow-exit",
		"process:allow-restart",
		"store:default",
		"updater:default",
		{ "identifier": "opener:allow-open-url", "allow": [{ "url": "https://*" }, { "url": "http://localhost:*" }] },
		{ "identifier": "http:default", "allow": [{ "url": "https://*" }, { "url": "http://localhost:*" }] },
		{ "identifier": "fs:allow-read-dir", "allow": [{ "path": "**" }] },
		{ "identifier": "fs:allow-exists", "allow": [{ "path": "**" }] },
		{ "identifier": "fs:allow-stat", "allow": [{ "path": "**" }] },
		{ "identifier": "fs:allow-read-file", "allow": [{ "path": "**/SavedVariables/InnkeeperSync.lua" }] }
	]
}
