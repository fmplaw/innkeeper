# Seule variable obligatoire : l'URL publique du site, sans slash final. Elle sert
# aux redirections Discord et à la protection des formulaires : elle doit
# correspondre à l'adresse tapée dans le navigateur.
ORIGIN=http://localhost:3000

# Tout le reste (application Discord, serveur, profil de guilde, rôles) se
# configure dans l'assistant d'installation : ouvrir <ORIGIN>/installation au
# premier démarrage, avec le code affiché dans les logs du conteneur.

# Derrière un reverse proxy, pour que la limite de tentatives de connexion admin
# voie la vraie adresse des visiteurs (ne pas activer sans proxy devant) :
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1

# Déploiement derrière Traefik sur le même hôte (docker-compose.traefik.yml).
# ORIGIN est alors calculé automatiquement : https://<SITE_DOMAIN>
# SITE_DOMAIN=guilde.mondomaine.fr
# TRAEFIK_NETWORK=traefik        # réseau Docker partagé avec Traefik
# TRAEFIK_ENTRYPOINT=websecure   # entrypoint HTTPS de Traefik
# TRAEFIK_CERTRESOLVER=letsencrypt

# Facultatif :
# AUTH_SECRET=         # secret des sessions ; généré et conservé en base s'il est absent
# PORT=3000
# DATABASE_PATH=/data/guilde.db
# BACKUP_INTERVAL_HOURS=24   # copie de la base par le site ; 0 la désactive
# BACKUP_KEEP=14              # copies conservées
# BACKUP_DIR=/backups
# INNKEEPER_DEMO=1     # mode démo : guilde fictive, Discord et Raid-Helper simulés (base vide uniquement)
